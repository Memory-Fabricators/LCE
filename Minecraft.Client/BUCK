CLIENT_GL_ARGS = [
    "-std=c++26",
    "-D_SDL3",
    "-DGL_GLES_PROTOTYPES",
    "-DGL_GLEXT_PROTOTYPES",
    "-DLCE_USE_MESA_GL",
]

cxx_library(
    name = "WindowsTypes",
    srcs = ["SDL3/WindowsTypes.cpp"],
    exported_headers = glob(["SDL3/WindowsTypes.h"]),
    compiler_flags = ["-std=c++26", "-D_SDL3", "-DLCE_SKIP_STDAFX"],
    public_include_directories = ["SDL3"],
    exported_deps = ["third_party//mimalloc:mimalloc"],
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "Minecraft.Client.headers",
    exported_headers = glob(["**/*.h", "**/*.hpp"]),
    public_include_directories = [
        ".",
        "Common",
        "SDL3",
        "SDL3/stubs",
        "SDL3Media",
        "ruffle_bridge",
    ],
    exported_deps = [
        ":WindowsTypes",
        "//angle_wgpu:angle_wgpu_cc",
        "//ruffle_bridge:ruffle_bridge_cc",
    ],
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "Minecraft.Client.4JRender",
    srcs = ["SDL3/4JLibs/src/4J_Render.cpp"],
    exported_headers = glob(["**/*.h", "**/*.hpp"]),
    compiler_flags = CLIENT_GL_ARGS + ["-DLCE_SKIP_STDAFX"],
    public_include_directories = [
        ".",
        "Common",
        "SDL3",
        "SDL3/stubs",
        "SDL3Media",
        "ruffle_bridge",
    ],
    exported_deps = [
        ":WindowsTypes",
        "//angle_wgpu:angle_wgpu_cc",
        "//ruffle_bridge:ruffle_bridge_cc",
        "third_party//mimalloc:mimalloc",
    ],
    visibility = ["PUBLIC"],
)

cxx_binary(
    name = "Minecraft.Client",
    srcs = glob(
        [
            "*.cpp",
            "Common/**/*.cpp",
            "SDL3/**/*.cpp",
            "Xbox/Network/NetworkPlayerXbox.cpp",
            "Common/UI/UIFontData.cpp",
        ],
        exclude = [
            "CreativeMode.cpp",
            "Common/UI/**",
            "Common/Consoles_App.cpp",
            "Common/Audio/SoundEngine.cpp",
            "Common/Network/Sony/**",
            "Common/XUI/**",
            "Common/Tutorial/XuiCraftingTask.cpp",
            "SDL3/4JLibs/src/4J_Render.cpp",
        ],
    ) + [
        "Common/UI/UIFontData.cpp",
    ],
    compiler_flags = CLIENT_GL_ARGS + [
        '-DLCE_ASSETS_DIR_DEFAULT="Minecraft.Client"',
        "-include",
        "Minecraft.Client/stdafx.h",
    ],
    include_directories = [
        ".",
        "Common",
        "SDL3",
        "SDL3/stubs",
        "SDL3Media",
        "ruffle_bridge",
    ],
    # angle_wgpu's EGL entry points (eglGetDisplay etc.) are statically
    # linked into this binary rather than living in a separate libEGL.so,
    # so overlay tools like MangoHud that dlsym(RTLD_NEXT, "eglGetDisplay")
    # need those symbols exported in our own dynamic symbol table.
    linker_flags = select({
        "prelude//os:linux": [
            "-rdynamic",
            # angle_wgpu's EGL entry points are only referenced by
            # external overlay tools via dlsym(RTLD_NEXT, ...), so nothing
            # in this binary's own object graph pulls in the archive
            # members defining them; force the linker to keep them so
            # -rdynamic actually has something to export.
            "-Wl,--undefined=eglGetDisplay",
            "-Wl,--undefined=eglInitialize",
            "-Wl,--undefined=eglGetProcAddress",
            "-Wl,--undefined=eglSwapBuffers",
            "-Wl,--undefined=eglMakeCurrent",
            "-Wl,--undefined=eglCreateContext",
            "-Wl,--undefined=eglCreateWindowSurface",
            "-Wl,--undefined=eglChooseConfig",
            "-Wl,--undefined=eglGetConfigAttrib",
            "-Wl,--undefined=eglTerminate",
            "-Wl,--undefined=eglDestroyContext",
            "-Wl,--undefined=eglDestroySurface",
            "-Wl,--undefined=eglQueryString",
            "-Wl,--undefined=eglBindAPI",
            "-Wl,--undefined=eglSwapInterval",
        ],
        "DEFAULT": [],
    }),
    deps = [
        ":Minecraft.Client.4JRender",
        ":WindowsTypes",
        "//angle_wgpu:angle_wgpu_cc",
        "//ruffle_bridge:ruffle_bridge_cc",
        "//Minecraft.World:Minecraft.World",
        "third_party//mimalloc:mimalloc",
        "third_party//zlib-ng:zlib",
    ],
    visibility = ["PUBLIC"],
)

filegroup(
    name = "media",
    srcs = glob(["Common/Media/**", "Windows64Media/Media/**"]),
    visibility = ["PUBLIC"],
)
