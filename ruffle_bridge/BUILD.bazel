load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ruffle_bridge",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = [
        "@crates//:async-channel",
        "@crates//:indexmap",
        "@crates//:ruffle_core",
        "@crates//:ruffle_render",
        "@crates//:swf",
        "@crates//:url",
    ],
)

genrule(
    name = "ruffle_bridge_header",
    srcs = glob(["src/**/*.rs"]) + ["cbindgen.toml"],
    outs = ["ruffle_bridge.h"],
    cmd = "$(execpath @crates//:cbindgen__cbindgen) --config $(location cbindgen.toml) --output $@ $(location src/lib.rs)",
    tools = ["@crates//:cbindgen__cbindgen"],
)

cc_library(
    name = "ruffle_bridge_cc",
    hdrs = [":ruffle_bridge_header"],
    includes = ["."],
    deps = [":ruffle_bridge"],
)
