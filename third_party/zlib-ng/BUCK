http_archive(
    name = "zlib-ng-src",
    urls = ["https://github.com/zlib-ng/zlib-ng/archive/7cf22b9e19e08cf6719e48433681349c2a5f1d7e.tar.gz"],
    sha256 = "661c30d260d37a4f04a0cbb3e8cae701e176f63dcad669ba5cb9ff1172fcf37e",
    strip_prefix = "zlib-ng-7cf22b9e19e08cf6719e48433681349c2a5f1d7e",
    sub_targets = _BASE_SRCS + _ARM_SRCS + _X86_SRCS,
    type = "tar.gz",
)

genrule(
    name = "zconf_gen",
    srcs = [":zlib-ng-src"],
    out = "zconf.h",
    cmd = "cp $(location :zlib-ng-src)/zconf.h.in $OUT",
)

genrule(
    name = "zlib_gen",
    srcs = [":zlib-ng-src"],
    out = "zlib.h",
    cmd = "sed 's/@ZLIB_SYMBOL_PREFIX@//g' $(location :zlib-ng-src)/zlib.h.in > $OUT",
)

genrule(
    name = "zlib_name_mangling_gen",
    srcs = [":zlib-ng-src"],
    out = "zlib_name_mangling.h",
    cmd = "cp $(location :zlib-ng-src)/zlib_name_mangling.h.empty $OUT",
)

genrule(
    name = "gzread_gen",
    srcs = [":zlib-ng-src"],
    out = "gzread_mangle.h",
    cmd = "sed 's/@ZLIB_SYMBOL_PREFIX@//g' $(location :zlib-ng-src)/gzread_mangle.h.in > $OUT",
)




_GNU_COPTS = [
    "-std=c11",
    "-Wno-deprecated-non-prototype",
    "-Wno-implicit-function-declaration",
    "-Wno-unused-variable",
]

cxx_library(
    name = "zlib-ng",
    srcs = [":zlib-ng-src[" + f + "]" for f in _BASE_SRCS] + select({
        "DEFAULT": [],
        "prelude//cpu:arm64": [":zlib-ng-src[" + f + "]" for f in _ARM_SRCS],
        "prelude//cpu:x86_64": [":zlib-ng-src[" + f + "]" for f in _X86_SRCS],
    }),
    raw_headers = [":zlib-ng-src"],
    headers = {
        "zconf.h": ":zconf_gen",
        "zlib_name_mangling.h": ":zlib_name_mangling_gen",
        "gzread_mangle.h": ":gzread_gen",
    },
    exported_headers = {
        "zlib.h": ":zlib_gen",
    },
    header_namespace = "",
    compiler_flags = _GNU_COPTS + [
        "-I$(location :zlib-ng-src)",
        "-I.",
    ],
    preprocessor_flags = [
        "-DZLIB_COMPAT",
        "-DWITH_GZFILEOP",
        "-DWITH_OPTIM",
        "-DWITH_NEW_STRATEGIES",
        "-DWITH_ALL_FALLBACKS",
    ] + select({
        "DEFAULT": [],
        "prelude//cpu:arm64": ["-DARM_FEATURES"],
        "prelude//cpu:x86_64": ["-DX86_FEATURES"],
    }),
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

alias(
    name = "zlib",
    actual = ":zlib-ng",
    visibility = ["PUBLIC"],
)
