load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "angle_wgpu",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    deps = [
        "@crates//:bytemuck",
        "@crates//:glam",
        "@crates//:log",
        "@crates//:parking_lot",
        "@crates//:raw-window-handle",
        "@crates//:x11-dl",
        "@crates//:wgpu",
        "@crates//:winit",
        "@crates//:zune-core",
        "@crates//:zune-png",
    ],
)

genrule(
    name = "angle_wgpu_header",
    srcs = glob(["src/**/*.rs"]) + ["cbindgen.toml"],
    outs = ["angle_wgpu.h"],
    cmd = "$(execpath @crates//:cbindgen__cbindgen) --config $(location cbindgen.toml) --output $@ $(location src/lib.rs)",
    tools = ["@crates//:cbindgen__cbindgen"],
)

cc_library(
    name = "angle_wgpu_cc",
    hdrs = [":angle_wgpu_header"],
    includes = ["."],
    deps = [":angle_wgpu"],
    linkopts = select({
        "@platforms//os:macos": [
            "-Wl,-framework,Metal",
            "-Wl,-framework,CoreGraphics",
            "-Wl,-framework,QuartzCore",
            "-Wl,-framework,AppKit",
            "-Wl,-framework,Foundation",
            "-Wl,-framework,IOKit",
            "-Wl,-framework,CoreVideo",
            "-Wl,-framework,Carbon",
        ],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "angle_wgpu_test",
    srcs = ["test_main.cpp"],
    deps = [
        ":angle_wgpu_cc",
    ],
)
